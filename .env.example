# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings → API → "service_role" secret.
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Used by the admin user-management pages (list/block/delete accounts) and
# by the checkout flow (writing orders on a guest's behalf).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Revolut Merchant API — Revolut Business dashboard → Merchant account →
# Developer → API keys. Start with the sandbox values (sandbox-merchant.
# revolut.com + a sandbox secret key) — switch both to the live equivalents
# only once checkout is fully tested.
REVOLUT_API_BASE_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=your-revolut-secret-key

# From the same dashboard: Merchant account → Webhooks → add an endpoint
# pointing at https://<your-domain>/api/webhooks/revolut, select the
# ORDER_COMPLETED / ORDER_AUTHORISED / ORDER_CANCELLED / ORDER_PAYMENT_*
# events, then copy the signing secret it gives you here.
REVOLUT_WEBHOOK_SIGNING_SECRET=your-revolut-webhook-signing-secret

# Merchize — print-on-demand/dropship fulfilment. Merchize dashboard → API
# page has your store's own base URL (not a fixed global one) and access
# token together.
MERCHIZE_API_BASE_URL=https://your-store.merchize.com
MERCHIZE_ACCESS_TOKEN=your-merchize-access-token
# "live" once you're ready for real orders — anything else (or unset) marks
# every order created as a Merchize test order (is_test: true).
MERCHIZE_MODE=sandbox

# Merchize dashboard → Webhooks → add an endpoint pointing at
# https://<your-domain>/api/webhooks/merchize, select the order-lifecycle
# events you want reflected on orders (created, changed progress/shipment/
# tracking, invalid address, importer error, issue updated — skip the
# payment/fee ones, not used here), then copy the value they send in the
# merchize-webhook-key header to here.
MERCHIZE_WEBHOOK_KEY=your-merchize-webhook-key
