# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings → API → "service_role" secret.
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Used only by the admin user-management pages (list/block/delete accounts),
# which the Supabase Admin API requires regardless of RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
