# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings → API → "service_role" secret.
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Used by the admin user-management pages (list/block/delete accounts) and
# by the checkout flow (writing orders on a guest's behalf).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Revolut Merchant API — Revolut Business dashboard → Merchant account →
# Developer → API keys. Start with the sandbox values (sandbox-merchant.
# revolut.com + a sandbox secret key) — switch both to the live equivalents
# only once checkout is fully tested.
REVOLUT_API_BASE_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=your-revolut-secret-key

# From the same dashboard: Merchant account → Webhooks → add an endpoint
# pointing at https://<your-domain>/api/webhooks/revolut, select the
# ORDER_COMPLETED / ORDER_AUTHORISED / ORDER_CANCELLED / ORDER_PAYMENT_*
# events, then copy the signing secret it gives you here.
REVOLUT_WEBHOOK_SIGNING_SECRET=your-revolut-webhook-signing-secret
