# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings → API → "service_role" secret.
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Used by the admin user-management pages (list/block/delete accounts) and
# by the checkout flow (writing orders on a guest's behalf).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Revolut Merchant API — Revolut Business dashboard → Merchant account →
# Developer → API keys. Start with the sandbox values (sandbox-merchant.
# revolut.com + a sandbox secret key) — switch both to the live equivalents
# only once checkout is fully tested.
REVOLUT_API_BASE_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=your-revolut-secret-key

# Revolut's dashboard has no webhook UI on this account, so it's registered
# via their API instead — sign in as an admin and use /admin/webhooks, which
# registers https://<your-domain>/api/webhooks/revolut for the
# ORDER_COMPLETED / ORDER_AUTHORISED / ORDER_CANCELLED / ORDER_PAYMENT_*
# events and shows you the signing secret to paste here.
REVOLUT_WEBHOOK_SIGNING_SECRET=your-revolut-webhook-signing-secret

# Merchize — print-on-demand/dropship fulfilment. Merchize dashboard → API
# Reference page has your store's Base URL and Access Token together. Copy
# the Base URL exactly as shown, including its store-specific path segment
# (e.g. https://bo-group-1-2.merchize.com/vnsnr6g/bo-api) — the bare domain
# alone doesn't identify your store and returns a Cloudflare 502.
MERCHIZE_API_BASE_URL=https://bo-group-1-2.merchize.com/your-store-path/bo-api
MERCHIZE_ACCESS_TOKEN=your-merchize-access-token
# "live" once you're ready for real orders — anything else (or unset) marks
# every order created as a Merchize test order (is_test: true).
MERCHIZE_MODE=sandbox

# Merchize dashboard → Webhooks → add an endpoint pointing at
# https://<your-domain>/api/webhooks/merchize, select the order-lifecycle
# events you want reflected on orders (created, changed progress/shipment/
# tracking, invalid address, importer error, issue updated — skip the
# payment/fee ones, not used here), then copy the value they send in the
# merchize-webhook-key header to here.
MERCHIZE_WEBHOOK_KEY=your-merchize-webhook-key

# The Journal feed sync (src/app/api/cron/feed-sync) — pulls candidate
# videos from YouTube, has Claude classify/draft the relevant ones as
# review-ready drafts. All three are needed for the cron job; the site
# itself runs fine without them (the Journal page just shows nothing until
# an admin publishes something manually or the sync starts finding items).

# Google Cloud Console → APIs & Services → Credentials → Create Credentials
# → API key, after enabling "YouTube Data API v3" for the project. Public
# read-only data, no OAuth needed. Free tier is 10,000 quota units/day;
# search.list costs 100 units per call, comfortably covers one run/day.
YOUTUBE_API_KEY=your-youtube-data-api-key

# console.anthropic.com → API Keys → Create Key. Needs a payment method on
# the org (Settings → Billing) — usage here is small (classifying/drafting
# a daily batch of candidates on Haiku), well under a dollar a month.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Authenticates calls to /api/cron/feed-sync so it can't be triggered by
# anyone who finds the URL. Vercel automatically sends this value as
# `Authorization: Bearer <CRON_SECRET>` on its own scheduled invocations
# (see vercel.json) once the env var is set — generate any long random
# string, e.g. `openssl rand -hex 32`.
CRON_SECRET=your-random-cron-secret
